{
  "schemaVersion": 1,
  "benchmarkId": "memi-interfacebench-v1",
  "title": "Memi InterfaceBench: Professional Product Design and Design Engineering",
  "status": "specification",
  "results": null,
  "purpose": "Measure whether an agent can turn real product-design work into a trustworthy, production-ready interface while preserving quality, source integrity, cost, and speed.",
  "protocol": {
    "targetTasks": 100,
    "taskSplit": {
      "publicDevelopment": 20,
      "privateTest": 60,
      "rollingHoldout": 20
    },
    "conditions": [
      "baseline",
      "memi"
    ],
    "minimumIndependentRuns": 3,
    "pairing": "Same pinned repository revision, task, fixtures, harness, model, reasoning level, preparation, and independent verification.",
    "randomization": "Condition order is seeded and counterbalanced within provider, task, and repeat.",
    "judgeBlinding": "Expert, visual, and model graders receive artifacts without condition, product, provider, or model labels.",
    "contaminationControl": "Private tests never enter routed context. Twenty percent of tasks rotate quarterly and any public leakage moves a task out of scored test splits.",
    "confidence": "Report stratified means and paired bootstrap 95% intervals with 10000 samples. Never average rejected, mismatched, or incomplete pairs.",
    "platformQuotas": {
      "reactWeb": 35,
      "reactNativeExpo": 20,
      "swiftUI": 20,
      "desktopCanvas": 10,
      "crossPlatform": 15
    }
  },
  "taskFamilies": [
    {
      "id": "existing-product-modification",
      "title": "Modify an existing product without collateral redesign",
      "weight": 18
    },
    {
      "id": "build-from-brief",
      "title": "Turn a product brief into a complete interface",
      "weight": 14
    },
    {
      "id": "reference-to-code",
      "title": "Reproduce a reference with semantic, editable code",
      "weight": 10
    },
    {
      "id": "design-system-application",
      "title": "Recover and correctly apply the local design system",
      "weight": 10
    },
    {
      "id": "interaction-and-state",
      "title": "Implement complex interaction, navigation, and product states",
      "weight": 12
    },
    {
      "id": "responsive-adaptive",
      "title": "Adapt layouts and behavior across realistic viewports",
      "weight": 10
    },
    {
      "id": "accessibility-remediation",
      "title": "Repair accessibility without degrading product behavior",
      "weight": 8
    },
    {
      "id": "native-mobile",
      "title": "Implement platform-native mobile product work",
      "weight": 8
    },
    {
      "id": "data-dense-visualization",
      "title": "Design accurate, readable data-dense interfaces",
      "weight": 5
    },
    {
      "id": "regression-debugging",
      "title": "Diagnose and repair visual or interaction regressions",
      "weight": 5
    }
  ],
  "scorecards": {
    "workProduct": {
      "role": "primary_quality_score",
      "dimensions": [
        {
          "id": "functional-correctness",
          "weight": 22,
          "grader": "deterministic",
          "description": "Required journeys, states, data, and error behavior work end to end."
        },
        {
          "id": "product-judgment",
          "weight": 12,
          "grader": "blinded_expert",
          "description": "The result solves the actual user problem without inventing adjacent scope."
        },
        {
          "id": "visual-quality",
          "weight": 14,
          "grader": "visual_plus_expert",
          "description": "Hierarchy, composition, typography, spacing, color, density, and polish are professionally coherent."
        },
        {
          "id": "interaction-quality",
          "weight": 10,
          "grader": "deterministic_plus_expert",
          "description": "Keyboard, pointer, touch, focus, motion, feedback, and state transitions are complete."
        },
        {
          "id": "responsive-adaptation",
          "weight": 9,
          "grader": "deterministic_visual",
          "description": "Behavior and information hierarchy remain correct across specified viewports and input modes."
        },
        {
          "id": "accessibility",
          "weight": 10,
          "grader": "deterministic_plus_manual",
          "description": "WCAG 2.2 AA automation, keyboard, focus, semantics, contrast, motion, and manual checks pass."
        },
        {
          "id": "design-system-fit",
          "weight": 9,
          "grader": "deterministic_plus_expert",
          "description": "Existing components, tokens, conventions, and platform patterns are reused correctly."
        },
        {
          "id": "maintainability",
          "weight": 7,
          "grader": "deterministic_plus_expert",
          "description": "The patch is scoped, typed, testable, readable, and avoids unnecessary dependencies or duplication."
        },
        {
          "id": "runtime-performance",
          "weight": 4,
          "grader": "deterministic",
          "description": "Interaction latency, frame pacing, layout stability, loading, and bundle effects remain within task budgets."
        },
        {
          "id": "platform-fidelity",
          "weight": 3,
          "grader": "deterministic_plus_expert",
          "description": "Web, iOS, Android, and desktop conventions are respected where applicable."
        }
      ]
    },
    "sourceTrust": {
      "role": "independent_trust_score",
      "dimensions": [
        {
          "id": "evidence-provenance",
          "weight": 30,
          "description": "Claims resolve to patches, screenshots, traces, source files, tests, or runtime artifacts."
        },
        {
          "id": "fixture-integrity",
          "weight": 25,
          "description": "Acceptance fixtures, graders, references, and hidden tests remain unchanged."
        },
        {
          "id": "decision-trace",
          "weight": 20,
          "description": "The run records selected skills, repository evidence, changed surfaces, commands, timing, and failures."
        },
        {
          "id": "source-alignment",
          "weight": 15,
          "description": "The implementation follows the pinned repository and authentic product source rather than guessed conventions."
        },
        {
          "id": "uncertainty-honesty",
          "weight": 10,
          "description": "Missing evidence, partial coverage, rejected runs, and unassessed metrics are reported explicitly."
        }
      ]
    },
    "efficiency": {
      "role": "pareto_metric",
      "primaryCostEvidenceOrder": [
        "measured_usd",
        "total_token_proxy"
      ],
      "metrics": [
        "wall_time_ms",
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "human_interventions",
        "defects",
        "retries"
      ],
      "toolCallRole": "diagnostic_only",
      "policy": "Rank systems on the quality-cost-latency Pareto frontier. Never blend efficiency into quality or reward a cheap failed run."
    }
  },
  "grading": {
    "order": [
      "integrity_and_disqualifiers",
      "deterministic_build_and_journeys",
      "accessibility_and_performance",
      "rendered_visual_comparison",
      "blinded_expert_rubric",
      "blinded_pairwise_preference"
    ],
    "taskScoreFormula": "max(0, positive_points_minus_penalties) / total_positive_points * 100",
    "aggregateQualityFormula": "0.75 * workProduct + 0.25 * sourceTrust after hard gates",
    "humanAdjudication": "Two independent senior product design or design-engineering graders; a third resolves differences greater than 10 points.",
    "visualEvaluation": "Render deterministic screenshots at declared viewports, mask dynamic content, measure structure and geometry, then use blinded expert comparison. Pixel or embedding similarity never stands alone.",
    "preferenceEvaluation": "Collect blinded pairwise preference after functional hard gates and report Bradley-Terry estimates separately from rubric scores."
  },
  "globalDisqualifiers": [
    {
      "id": "fixture-tampering",
      "effect": "task_score_zero",
      "description": "The agent modified, deleted, bypassed, or weakened a benchmark fixture or grader."
    },
    {
      "id": "fabricated-evidence",
      "effect": "task_score_zero",
      "description": "The agent fabricated screenshots, traces, metrics, citations, or successful verification."
    },
    {
      "id": "build-failure",
      "effect": "task_score_zero",
      "description": "The required production build or native build does not complete."
    },
    {
      "id": "critical-journey-failure",
      "effect": "work_product_cap_49",
      "description": "A required user journey cannot be completed."
    },
    {
      "id": "critical-accessibility-failure",
      "effect": "work_product_cap_59",
      "description": "The result introduces a blocker affecting keyboard, screen-reader, contrast, target size, or motion safety."
    },
    {
      "id": "scope-substitution",
      "effect": "penalty_20",
      "description": "The agent replaces the requested product work with a mock, static placeholder, unrelated redesign, or unsupported platform."
    }
  ],
  "releaseGates": [
    {
      "id": "quality-non-inferiority",
      "requirement": "Memi work-product and source-trust lower 95% bounds are no worse than baseline, with no increase in critical defects."
    },
    {
      "id": "positive-cost-evidence",
      "requirement": "Every canonical task family is non-negative and the aggregate paired cost-evidence lower 95% bound is positive."
    },
    {
      "id": "positive-latency",
      "requirement": "Every canonical task family is non-negative and the aggregate paired latency lower 95% bound is positive."
    },
    {
      "id": "repeat-stability",
      "requirement": "Release-critical tasks achieve pass^3 and the suite includes at least three independent paired runs per task."
    },
    {
      "id": "coverage",
      "requirement": "All task families, platform quotas, complexity tiers, and public/private/holdout splits meet the manifest."
    },
    {
      "id": "second-provider",
      "requirement": "At least two independent provider harnesses complete valid paired runs."
    }
  ],
