# Mémoire container image — binary edition.
#
# For environments where binaries + tarballs are blocked at the firewall but
# Docker pulls from ghcr.io are allowed (common in corporate networks).
#
# Run:
#   docker run --rm -it -v "$PWD:/work" -w /work ghcr.io/memi-design/memi --help
#
# For `memi connect` the Figma plugin has to reach the container's WebSocket.
#   docker run --rm -it -p 9223:9223 ghcr.io/memi-design/memi connect

FROM debian:bookworm-slim

ARG TARGETARCH
ARG VERSION=latest

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates coreutils curl tar \
 && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) target="linux-x64" ;; \
      arm64) echo "linux-arm64 not yet published" >&2; exit 1 ;; \
      *) echo "unsupported arch ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    if [ "${VERSION}" = "latest" ]; then \
      base="https://github.com/memi-design/memi/releases/latest/download"; \
    else \
      base="https://github.com/memi-design/memi/releases/download/${VERSION}"; \
    fi; \
    archive="memi-${target}.tar.gz"; \
    mkdir -p /tmp/memi-download; \
    curl -fsSL "${base}/${archive}" -o "/tmp/memi-download/${archive}"; \
    curl -fsSL "${base}/SHA256SUMS.txt" -o /tmp/memi-download/SHA256SUMS.txt; \
    grep " ${archive}\$" /tmp/memi-download/SHA256SUMS.txt > "/tmp/memi-download/${archive}.sha256"; \
    cd /tmp/memi-download; \
    sha256sum --check "${archive}.sha256"; \
    mkdir -p /opt-design/cli; \
    tar -xzf "${archive}" -C /opt-design/cli --strip-components=1; \
    rm -rf /tmp/memi-download; \
    chmod +x /opt-design/cli/memi; \
    ln -s /opt-design/cli/memi /usr/local/bin/memi

WORKDIR /work
EXPOSE 9223-9232

ENTRYPOINT ["memi"]
CMD ["--help"]
